{
  "name": "@openbooknetwork/harita",
  "version": "0.6.2",
  "description": "The map engine of the Open Book Network: zones, routes, markers, battles and relief on a MapLibre map, under the kitap shell",
  "keywords": [
    "map",
    "timeline",
    "history",
    "maplibre",
    "geojson",
    "static-site"
  ],
  "license": "MIT",
  "author": "Can Bascil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooknetwork/harita.git"
  },
  "homepage": "https://github.com/openbooknetwork/harita#readme",
  "bugs": {
    "url": "https://github.com/openbooknetwork/harita/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "harita": "bin/harita.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./src/schema.mjs",
    "./plans": "./src/plans.mjs",
    "./worker": "./src/worker.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "glyphs",
    "scripts/nest-map-fields.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@openbooknetwork/kitap": "^0.4.0",
    "@turf/turf": "^7.4.0",
    "js-yaml": "^4.1.0",
    "maplibre-gl": "5.24.0",
    "pngjs": "^7.0.0",
    "polylabel": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
