{
  "name": "@openhistoryatlas/harita",
  "version": "0.5.12",
  "description": "Interactive timelines on a map: a static site with a page per step in every language, built from a content folder",
  "keywords": [
    "map",
    "timeline",
    "history",
    "maplibre",
    "geojson",
    "static-site"
  ],
  "license": "MIT",
  "author": "Can Bascil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhistoryatlas/harita.git"
  },
  "homepage": "https://github.com/openhistoryatlas/harita#readme",
  "bugs": {
    "url": "https://github.com/openhistoryatlas/harita/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "harita": "bin/harita.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./src/schema.mjs",
    "./plans": "./src/plans.mjs",
    "./worker": "./src/worker.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "glyphs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@turf/turf": "^7.4.0",
    "aws4fetch": "^1.0.20",
    "js-yaml": "^4.1.0",
    "lucide-static": "^1.49.0",
    "maplibre-gl": "5.24.0",
    "marked": "^15.0.0",
    "pngjs": "^7.0.0",
    "polylabel": "^2.1.0",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  }
}
